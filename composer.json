{
    "name": "ghanover/mailman-sync",
    "description": "Sync with mailman list",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gavin Hanover",
            "email": "gavin@subnets.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "MailmanSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailmanSync\\Test\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/filesystem": "^11.0",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MailmanSync\\SyncServiceProvider"
            ],
            "aliases": {
                "MailmanGateway": "MailmanSync\\Facades\\MailmanGateway"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
